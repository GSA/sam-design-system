{
  "extends": "../apps/sam-design-system-site/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@gsa-sam/components": ["dist/libs/components", "libs/packages/components/src/index.ts"],
      "@gsa-sam/sam-formly": ["dist/libs/sam-formly", "libs/packages/sam-formly/src/index.ts"],
      "@gsa-sam/sam-material-extensions": [
        "dist/libs/sam-material-extensions",
        "libs/packages/sam-material-extensions/src/index.ts"
      ],
      "@gsa-sam/documentation": ["libs/documentation/src/index.ts"],
      "@ngx-formly/core/lib/models/fieldconfig": ["node_modules/@ngx-formly/core/lib/models/fieldconfig.d.ts"]
    }
  },
  "exclude": [
    "../src/test.ts",
    "../apps/**/*.spec.ts",
    "../libs/**/*.spec.ts",
    "../libs/documentation/src/sandbox/templates/*"
  ],
  "include": ["../apps/**/*", "../libs/**/*"],
  "files": ["./typings.d.ts", "../apps/sam-design-system-site/src/polyfills.ts"]
}
