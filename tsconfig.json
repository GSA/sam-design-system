{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "dom"
    ],
    "baseUrl": ".",
    "rootDir": ".",
    "useDefineForClassFields": false
  },
  "exclude": ["node_modules", "tmp"]
}
