{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "",
  "projects": {
    "components": {
      "root": "libs/packages/components",
      "sourceRoot": "libs/packages/components/src",
      "projectType": "library",
      "prefix": "sds",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/packages/components/src/**/*.ts", "libs/packages/components/src/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "outputs": ["dist/libs/components"],
          "options": {
            "tsConfig": "libs/packages/components/tsconfig.lib.json",
            "project": "libs/packages/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "libs/packages/components/tsconfig.lib.prod.json"
            }
          }
        },
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/components-test",
            "index": false,
            "browser": "libs/packages/components/src/test-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "libs/packages/components/tsconfig.spec.json",
            "optimization": false,
            "aot": false,
            "progress": false,
            "scripts": [
              "node_modules/accessible-html5-video-player/js/px-video.js",
              "node_modules/accessible-html5-video-player/js/strings.js"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "components:build-test",
            "tsConfig": "libs/packages/components/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["testing/vitest-setup.ts"],
            "coverage": true,
            "coverageExclude": ["**/*.html"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"]
          }
        }
      }
    },
    "sam-material-extensions": {
      "root": "libs/packages/sam-material-extensions",
      "sourceRoot": "libs/packages/sam-material-extensions/src",
      "projectType": "library",
      "prefix": "sds",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "libs/packages/sam-material-extensions/src/**/*.ts",
              "libs/packages/sam-material-extensions/src/**/*.html"
            ]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "outputs": ["dist/libs/sam-material-extensions"],
          "options": {
            "tsConfig": "libs/packages/sam-material-extensions/tsconfig.lib.json",
            "project": "libs/packages/sam-material-extensions/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "libs/packages/sam-material-extensions/tsconfig.lib.prod.json"
            }
          }
        },
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sam-material-extensions-test",
            "index": false,
            "browser": "libs/packages/sam-material-extensions/src/test-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "libs/packages/sam-material-extensions/tsconfig.spec.json",
            "optimization": false,
            "aot": false,
            "progress": false
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "sam-material-extensions:build-test",
            "tsConfig": "libs/packages/sam-material-extensions/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["testing/vitest-setup.ts"],
            "coverage": true,
            "coverageExclude": ["**/*.html"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"]
          }
        }
      }
    },
    "sam-formly": {
      "root": "libs/packages/sam-formly",
      "sourceRoot": "libs/packages/sam-formly/src",
      "projectType": "library",
      "prefix": "sds",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/packages/sam-formly/src/**/*.ts", "libs/packages/sam-formly/src/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "outputs": ["dist/libs/sam-formly"],
          "options": {
            "tsConfig": "libs/packages/sam-formly/tsconfig.lib.json",
            "project": "libs/packages/sam-formly/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "libs/packages/sam-formly/tsconfig.lib.prod.json"
            }
          }
        },
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sam-formly-test",
            "index": false,
            "browser": "libs/packages/sam-formly/src/test-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "libs/packages/sam-formly/tsconfig.spec.json",
            "optimization": false,
            "aot": false,
            "progress": false
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "sam-formly:build-test",
            "tsConfig": "libs/packages/sam-formly/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["testing/vitest-setup.ts"],
            "coverage": true,
            "coverageExclude": ["**/*.html"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"]
          }
        }
      }
    },
    "sam-design-system-site": {
      "root": "apps/sam-design-system-site/",
      "sourceRoot": "apps/sam-design-system-site/src",
      "projectType": "application",
      "prefix": "sds",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/sam-design-system-site/src/**/*.ts", "apps/sam-design-system-site/src/**/*.html"]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/apps/sam-design-system-site"
            },
            "index": "apps/sam-design-system-site/src/index.html",
            "polyfills": ["apps/sam-design-system-site/src/polyfills.ts"],
            "tsConfig": "apps/sam-design-system-site/tsconfig.app.json",
            "allowedCommonJsDependencies": ["lodash"],
            "assets": [
              "apps/sam-design-system-site/src/favicon.ico",
              "apps/sam-design-system-site/src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/@uswds/uswds/dist/fonts/",
                "output": "/assets/uswds/fonts/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@uswds/uswds/dist/img/",
                "output": "/assets/uswds/img/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@gsa-sam/sam-styles/sam-styles/packages/images",
                "output": "/assets/uswds/img/"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["./node_modules/@uswds/uswds/packages", "./node_modules/@gsa-sam/sam-styles"]
            },
            "styles": [
              "apps/sam-design-system-site/src/sds-styles.scss",
              "apps/sam-design-system-site/src/material.theme.scss"
            ],
            "scripts": [
              "node_modules/accessible-html5-video-player/js/px-video.js",
              "node_modules/accessible-html5-video-player/js/strings.js"
            ],
            "aot": false,
            "extractLicenses": false,
            "optimization": false,
            "namedChunks": true,
            "browser": "apps/sam-design-system-site/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "apps/sam-design-system-site/src/environments/environment.ts",
                  "with": "apps/sam-design-system-site/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "6mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "sam-design-system-site:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "sam-design-system-site:build:production"
            },
            "development": {
              "buildTarget": "sam-design-system-site:build:development"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "sam-design-system-site:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "sam-design-system-site:build-test",
            "tsConfig": "apps/sam-design-system-site/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["testing/vitest-setup.ts"],
            "coverage": true,
            "coverageExclude": ["**/*.html"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "sam-design-system-site:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "sam-design-system-site:build",
            "compodoc": false
          }
        },
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sam-design-system-site-test",
            "index": false,
            "browser": "apps/sam-design-system-site/src/test-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "apps/sam-design-system-site/tsconfig.spec.json",
            "optimization": false,
            "aot": false,
            "progress": false
          }
        }
      }
    },
    "documentation": {
      "root": "libs/documentation",
      "sourceRoot": "libs/documentation/src",
      "projectType": "library",
      "prefix": "gsa-sam",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/documentation/src/**/*.ts", "libs/documentation/src/**/*.html"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "documentation:build-test",
            "tsConfig": "libs/documentation/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["testing/vitest-setup.ts"],
            "coverage": true,
            "coverageExclude": ["**/*.html"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"]
          }
        },
        "build-test": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/documentation-test",
            "index": false,
            "browser": "libs/documentation/src/test-main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "libs/documentation/tsconfig.spec.json",
            "optimization": false,
            "aot": false,
            "progress": false,
            "externalDependencies": ["!!raw-loader!*"]
          }
        }
      }
    }
  },
  "cli": {
    "warnings": {
      "versionMismatch": false
    },
    "packageManager": "npm",
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
